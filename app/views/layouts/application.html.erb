<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "SegFox" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Canil SegFox: Terrier Brasileiro e Pastor da Mantiqueira.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="site-shell min-h-screen font-sans">
    <div class="site-background" aria-hidden="true"></div>
    <div class="relative z-10 min-h-screen flex flex-col">
      <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-4">
        <%= render "shared/navbar" %>
        <% flash.each do |type, message| %>
          <div role="status" class="my-4 rounded-lg px-4 py-3 <%= type.to_s == "notice" ? "bg-green-100 text-green-900" : "bg-red-100 text-red-900" %>">
            <%= message %>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
